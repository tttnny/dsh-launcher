{
  "name": "dsh-launcher",
  "private": true,
  "version": "0.2.9",
  "description": "Multi-version, multi-instance launcher for DeepSeek Harness (DSH)",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "app:local": "bash ci/build-local-app.sh",
    "test:release-notes": "node --test ci/release-notes.test.mjs",
    "test:api-contract": "node --test ci/api-contract.test.mjs",
    "test:setup-guidance": "node --test ci/setup-guidance.test.mjs"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^6.0.3",
    "@tauri-apps/cli": "^2.9.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
