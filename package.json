{
  "name": "dsh-launcher",
  "private": true,
  "version": "0.0.1-rc.1",
  "description": "Multi-version, multi-instance launcher for DeepSeek Harness (DSH)",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "app:local": "bash scripts/build-local-app.sh",
    "format": "prettier --write .",
    "verify": "bash scripts/verify.sh",
    "verify:quick": "bash scripts/verify.sh --quick"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.10",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
